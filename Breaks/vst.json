{
  "name": "Breaks",
  "vendor": "quirkey",
  "about": "Plays a drum break in time with the song: 16th slices retriggered on the song grid, with pitch, grit and variations.",
  "uid": "QkBr",
  "version": 1000,
  "so": "breaks.so",
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "skin_post": "tools/skin_post.py",
  "defines": {
    "HAS_SONG_POS": 1,
    "HAS_DISPLAY_REV": 1,
    "PARAM_TEXT_MAX": 64,
    "MODULE_SUBDIR": "\"breaks\""
  },
  "build": {
    "root": "..",
    "sources": [
      "Breaks/Breaks.cpp"
    ],
    "cflags": [],
    "cflags_arm": [
      "-mcpu=cortex-a17",
      "-mfpu=neon-vfpv4",
      "-ffast-math"
    ],
    "libs": [
      "-lm"
    ]
  },
  "user_data": [
    "breaks"
  ]
}
